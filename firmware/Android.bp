genrule {
    name: "msm8998_common_gen_firmware_ipa_fws.mbn",
    tools: ["pil-squasher"],
    out: ["ipa_fws.mbn"],
    cmd: "$(location pil-squasher) $(out) ../../../../vendor/xiaomi/msm8998-common/proprietary/vendor/firmware/ipa_fws.mdt",
}

prebuilt_firmware {
    name: "msm8998_common_firmware_ipa_fws.mbn",
    src: ":msm8998_common_gen_firmware_ipa_fws.mbn",
    filename_from_src: true,
    device_specific: true,
    sub_dir: "qcom/msm8998/xiaomi",
}

install_symlink {
    name: "msm8998_common_symlink_firmware_ipa_fws.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/msm8998/xiaomi/ipa_fws.mbn",
    symlink_target: "/odm/etc/firmware/qcom/msm8998/xiaomi/ipa_fws.mbn",
}

